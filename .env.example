# Consumer API base URL. Required in every environment.
# Without this the app falls back to the *dev* API Gateway, so a production
# build with the variable unset will silently talk to dev.
NEXT_PUBLIC_API_BASE_URL=https://pk1wr06fr1.execute-api.af-south-1.amazonaws.com/dev

# Google OAuth client id (public by design).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Route API calls through the Next.js proxy instead of calling the API directly.
# NEXT_PUBLIC_ENABLE_PROXY=true

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Leave unset and Sentry is inert — the SDK initialises and reports nothing.
# Nothing breaks without it; you are simply not monitored.
NEXT_PUBLIC_SENTRY_DSN=

# Labels events in the Sentry UI. Defaults to NODE_ENV if unset; set it
# explicitly on Netlify so preview deploys don't look like production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# BUILD-TIME ONLY — needed to upload source maps, without which stack traces
# read `main-8f3a.js:1:99213` instead of naming a real file. Do NOT prefix these
# with NEXT_PUBLIC_; the auth token must never reach the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

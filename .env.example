# Consumer API base URL. REQUIRED — a production build now fails without it.
# It used to fall back to the dev API Gateway, which meant a production deploy
# that forgot this variable served dev data to real users and looked healthy
# doing it. Local development still falls back.
NEXT_PUBLIC_API_BASE_URL=https://pk1wr06fr1.execute-api.af-south-1.amazonaws.com/dev

# Origin serving uploaded property photos and video. Required in every
# environment. Feeds BOTH the Content-Security-Policy and next/image's
# remotePatterns, so a wrong value here shows up as images that silently do not
# load rather than as an error.
NEXT_PUBLIC_S3_ORIGIN=https://housinghub-files-dev.s3.af-south-1.amazonaws.com

# Google OAuth client id (public by design).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Route API calls through the Next.js proxy instead of calling the API directly.
# NEXT_PUBLIC_ENABLE_PROXY=true

# Real-time chat and notifications over SignalR.
#
# LEAVE UNSET IN ANY DEPLOYED ENVIRONMENT. The API runs on Lambda behind an API
# Gateway REST API, which cannot hold a WebSocket open, so Program.cs does not map
# the hubs there and /hubs/chat/negotiate correctly returns 404. Chat and
# notifications fall back to polling, which works.
#
# Set to true only when running the API locally with `dotnet run`, where the hubs
# are mapped.
# NEXT_PUBLIC_ENABLE_REALTIME=true

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Leave unset and Sentry is inert — the SDK initialises and reports nothing.
# Nothing breaks without it; you are simply not monitored.
NEXT_PUBLIC_SENTRY_DSN=

# Labels events in the Sentry UI. This file is a dev reference, so it says
# development — the variable's whole purpose is keeping dev and preview events out
# of the alert you watch for production, and defaulting it to `production` here
# defeated that the moment anyone copied the file.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# BUILD-TIME ONLY — needed to upload source maps, without which stack traces
# read `main-8f3a.js:1:99213` instead of naming a real file. Do NOT prefix these
# with NEXT_PUBLIC_; the auth token must never reach the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
